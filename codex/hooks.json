{
  "description": "Scrim: track tool sizes, cap listings before they run (SCRIM_ROOT is replaced by make codex-hooks)",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SCRIM_ROOT/hooks/run.sh pretooluse.py",
            "timeout": 5,
            "statusMessage": "scrim: capping listings"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SCRIM_ROOT/hooks/run.sh posttooluse.py",
            "timeout": 25,
            "statusMessage": "scrim: tracking tool output"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SCRIM_ROOT/hooks/run.sh events.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SCRIM_ROOT/hooks/run.sh events.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SCRIM_ROOT/hooks/run.sh events.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SCRIM_ROOT/hooks/run.sh stop.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
